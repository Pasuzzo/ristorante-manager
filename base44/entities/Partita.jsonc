{
  "name": "Partita",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string"
    },
    "stato": {
      "type": "object"
    },
    "turni_giocati": {
      "type": "number",
      "default": 0
    },
    "game_over": {
      "type": "boolean",
      "default": false
    },
    "ultimo_report": {
      "type": "object"
    },
    "ultimo_bandi": {
      "type": "array"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}